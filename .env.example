# Copy this file to .env and fill in your keys. .env is ignored by git and never shared.
PORT=3000

# AI summaries: set ONE provider key (or more; the first found is used)
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# AI_PROVIDER=openrouter   # optional: 'openrouter' or 'nvidia'
# AI_MODEL=openrouter/free # optional: override model (e.g., 'openrouter/free' or 'meta/llama-3.2-11b-vision-instruct')

# Optional GitHub token (raises GitHub limit to 5000/hour)
GITHUB_TOKEN=

DB_PATH=./data/ranker.db
CACHE_TTL_HOURS=6
